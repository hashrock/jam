{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jam",
  "main": "./app/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "jam.hashrock.info", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jam-db",
      "database_id": "b151a1f7-21e2-4309-9b21-a1272063cfc4"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
